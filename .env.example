# Copie para .env e troque TODOS os CHANGE_ME. Nunca versione o .env.
APP_ENV=dev
DOCS_HABILITADO=false
HTTP_PORT=8080

POSTGRES_DB=sigpmf
POSTGRES_USER=sigpmf
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_com_pelo_menos_32_caracteres
JWT_EXPIRA_MINUTOS=60
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=CHANGE_ME

CPF_REVEAL_PERFIS=admin_lgpd
REVELAR_MOTIVO_MIN=10
REVELAR_CPF_SEGUNDOS=60
AMOSTRA_LIMITE=100
LOTE_TAMANHO=500

# Conector SQL Server (somente leitura). Vazio = nenhuma origem real configurada.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TIMEOUT=5
# Amostra controlada: máximo de linhas lidas por tabela da origem
AMOSTRA_LIMITE=1000
# Banco de origem por conector (PB12). Vazio = usa SQLSERVER_DATABASE (fallback registrado no controle).
SQLSERVER_DATABASE_SAUDE=
SQLSERVER_DATABASE_CEMITERIO=
SQLSERVER_DATABASE_ISS=
