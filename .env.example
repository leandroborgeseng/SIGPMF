# Copie para .env e troque TODOS os CHANGE_ME. Nunca versione o .env.
APP_ENV=dev
DOCS_HABILITADO=false
HTTP_PORT=8080

POSTGRES_DB=sigpmf
POSTGRES_USER=sigpmf
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_com_pelo_menos_32_caracteres
JWT_EXPIRA_MINUTOS=60
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=CHANGE_ME

CPF_REVEAL_PERFIS=admin_lgpd
REVELAR_MOTIVO_MIN=10
REVELAR_CPF_SEGUNDOS=60
AMOSTRA_LIMITE=100
LOTE_TAMANHO=500

# Conector SQL Server (somente leitura). Vazio = nenhuma origem real configurada.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TIMEOUT=5
# Tempo máximo de cada consulta à origem (s). Tabelas grandes da Saúde precisam de mais que o login.
SQLSERVER_CONSULTA_TIMEOUT=120
# Amostra controlada: máximo de linhas lidas por tabela da origem
AMOSTRA_LIMITE=1000
# API SIL (tributário novo), só leitura. Produção: https://interface.siltecnologia.com.br/v1
# (homologação: https://interface-sandbox.siltecnologia.com.br/v1). Vazio = conector SIL desligado.
SIL_BASE_URL=
SIL_CLIENT_ID=
SIL_CLIENT_SECRET=
SIL_SCOPE=
# Pausa entre chamadas à API (ms), para não pesar no fornecedor
SIL_INTERVALO_MS=150
# Banco de origem por conector (PB12). Vazio = usa SQLSERVER_DATABASE (fallback registrado no controle).
SQLSERVER_DATABASE_SAUDE=
SQLSERVER_DATABASE_CEMITERIO=
SQLSERVER_DATABASE_ISS=
# Tributário (onda 2)
SQLSERVER_DATABASE_IPTU=
SQLSERVER_DATABASE_DIVIDA=
SQLSERVER_DATABASE_FINANCEIRO=
# Financeiro_Exercicio só a partir deste exercício (vazio = exercício atual e o anterior)
# FINANCEIRO_EXERCICIO_MIN=2025

# Agenda das cargas completas (AG1–AG6). Desligada por padrão; ligue cada conector na tela Conectores.
AGENDA_HABILITADA=false
# Janela em que a agenda pode iniciar cargas. Produção: 00:00-06:00. Homologação: 00:00-24:00 (o dia todo).
AGENDA_JANELA=00:00-06:00
AGENDA_FUSO=America/Sao_Paulo
AGENDA_INTERVALO_S=60
# Pula o conector quando COUNT(*) e MAX(campo incremental) da origem não mudaram desde a última carga.
AGENDA_PULAR_SEM_MUDANCA=true
AGENDA_TENTATIVAS=3
AGENDA_REESPERA_MIN=30
AGENDA_ESPERA_MAX_H=20
# A agenda lê só o que mudou (incremental) e faz uma carga completa a cada N dias (pega exclusões na origem).
AGENDA_COMPLETA_DIAS=7
# A incremental relê desde (maior data já gravada − margem), para não perder alterações gravadas com atraso.
CARGA_INCREMENTAL_MARGEM_H=24
# Alerta de falha por e-mail (opcional). Sem SMTP_HOST, a falha fica só na tela e na auditoria.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=true
ALERTA_DE=
ALERTA_PARA=

# Retenção diária (onda 7): versões antigas da bronze e logs técnicos. A auditoria nunca é apagada.
RETENCAO_BRONZE_VERSOES_DIAS=7
RETENCAO_LOGS_DIAS=90
