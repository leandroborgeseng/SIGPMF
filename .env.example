# Copie para .env e troque TODOS os CHANGE_ME. Nunca versione o .env.
APP_ENV=dev
DOCS_HABILITADO=false
HTTP_PORT=8080

POSTGRES_DB=sigpmf
POSTGRES_USER=sigpmf
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_com_pelo_menos_32_caracteres
# Segredo do HMAC-SHA256 das chaves da prata do modelo (obrigatório fora de testes; >= 32 caracteres; nunca trocar sem recalcular)
SIGPMF_CHAVE_HASH_SEGREDO=CHANGE_ME_com_pelo_menos_32_caracteres
JWT_EXPIRA_MINUTOS=60
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=CHANGE_ME

CPF_REVEAL_PERFIS=admin_lgpd
# N3a: CPFs de preenchimento (vírgula), vão para a quarentena cpf_invalido
CPF_PREENCHIMENTO=12345678909
REVELAR_MOTIVO_MIN=10
REVELAR_CPF_SEGUNDOS=60
AMOSTRA_LIMITE=100
LOTE_TAMANHO=500

# Conector SQL Server (somente leitura). Vazio = nenhuma origem real configurada.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TIMEOUT=5
# Tempo máximo de cada consulta à origem (s). Tabelas grandes da Saúde precisam de mais que o login.
SQLSERVER_CONSULTA_TIMEOUT=120
# Amostra controlada: máximo de linhas lidas por tabela da origem
AMOSTRA_LIMITE=1000
# API SIL (tributário novo), só leitura. Produção: https://interface.siltecnologia.com.br/v1
# (homologação: https://interface-sandbox.siltecnologia.com.br/v1). Vazio = conector SIL desligado.
SIL_BASE_URL=
SIL_CLIENT_ID=
SIL_CLIENT_SECRET=
SIL_SCOPE=
# Pausa entre chamadas à API (ms), para não pesar no fornecedor
SIL_INTERVALO_MS=150
# Banco de origem por conector (PB12). Vazio = usa SQLSERVER_DATABASE (fallback registrado no controle).
SQLSERVER_DATABASE_SAUDE=
SQLSERVER_DATABASE_CEMITERIO=
SQLSERVER_DATABASE_ISS=

# Conector SIL (API Franca), SOMENTE LEITURA. Desligado enquanto URL, CLIENT_ID e CLIENT_SECRET não estiverem
# definidos (SIL_BASE_URL, SIL_CLIENT_ID, SIL_CLIENT_SECRET e SIL_SCOPE acima). Valores só no Coolify/variáveis do servidor, nunca no repositório nem em chat.
# A autenticação tenta primeiro a homologação (SIL_BASE_URL_SANDBOX) e cai para a produção (SIL_BASE_URL).
SIL_BASE_URL_SANDBOX=
# "senha" enviada pela SIL: só usada se SIL_PASSWORD_CAMPO disser o nome do campo (a confirmar com a SIL).
SIL_PASSWORD=
SIL_PASSWORD_CAMPO=
SIL_TIMEOUT_S=10
SIL_TENTATIVAS=3
SIL_REQ_POR_S=2
# consultarlote: 1 lote por padrão; mais lotes só depois de validar a amostra (decisão TL 27/10).
SIL_CONSULTARLOTE_MAX_LOTES=1
# Amostra da SIL (botão "Rodar amostra"): lotes por amostra, padrão 20 (~1.000 linhas; teto fixo de 1.000 linhas).
SIL_AMOSTRA_MAX_LOTES=20

# Tributário (onda 2)
SQLSERVER_DATABASE_IPTU=
SQLSERVER_DATABASE_DIVIDA=
SQLSERVER_DATABASE_FINANCEIRO=
# Financeiro_Exercicio só a partir deste exercício (vazio = exercício atual e o anterior)
# FINANCEIRO_EXERCICIO_MIN=2025

# Agenda das cargas completas (AG1–AG6). Desligada por padrão; ligue cada conector na tela Conectores.
AGENDA_HABILITADA=false
# Janela em que a agenda pode iniciar cargas. Produção: 00:00-06:00. Homologação: 00:00-24:00 (o dia todo).
AGENDA_JANELA=00:00-06:00
AGENDA_FUSO=America/Sao_Paulo
AGENDA_INTERVALO_S=60
# Pula o conector quando COUNT(*) e MAX(campo incremental) da origem não mudaram desde a última carga.
AGENDA_PULAR_SEM_MUDANCA=true
AGENDA_TENTATIVAS=3
AGENDA_REESPERA_MIN=30
AGENDA_ESPERA_MAX_H=20
# A agenda lê só o que mudou (incremental). 0 = nunca agenda completa (só manual, ADMIN). N>0 = completa a cada N dias.
AGENDA_COMPLETA_DIAS=0
# A incremental relê desde (maior data já gravada − margem), para não perder alterações gravadas com atraso.
CARGA_INCREMENTAL_MARGEM_H=24
# Alerta de falha por e-mail (opcional). Sem SMTP_HOST, a falha fica só na tela e na auditoria.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=true
ALERTA_DE=
ALERTA_PARA=

# Retenção diária (onda 7): versões antigas da bronze e logs técnicos. A auditoria nunca é apagada.
RETENCAO_BRONZE_VERSOES_DIAS=7
RETENCAO_LOGS_DIAS=90

# Conector de educação (FRA_GestaoEscolar + FRA_CoreSSO), só leitura. Usuário próprio (db_datareader), nunca `sistema`.
SIGPMF_SRC_GESTAOESCOLAR_HOST=
SIGPMF_SRC_GESTAOESCOLAR_PORT=
SIGPMF_SRC_GESTAOESCOLAR_USER=
SIGPMF_SRC_GESTAOESCOLAR_PASSWORD=
SIGPMF_SRC_GESTAOESCOLAR_DB=FRA_GestaoEscolar
SIGPMF_SRC_CORESSO_DB=FRA_CoreSSO
SIGPMF_GESTAOESCOLAR_LOTE=1000
SIGPMF_GESTAOESCOLAR_MAX_LOTES=1
SIGPMF_GESTAOESCOLAR_AMOSTRA=50
# true (padrão) = carga completa da educação só na AGENDA_JANELA; só "false" (qualquer caixa) desliga; vazio/outro valor = ligada. false = a janela não bloqueia (registrado no log e na auditoria).
SIGPMF_EDUCACAO_JANELA_NOTURNA=true
# Minutos sem batida para o ADMIN marcar como falha uma carga completa da educação órfã.
SIGPMF_EDUCACAO_ORFA_MIN=30
# Pausa entre lotes da carga completa da educação (ms). 0 = sem pausa; inválido/negativo = 0 com WARNING.
SIGPMF_GESTAOESCOLAR_PAUSA_LOTE_MS=0
# Releitura de uma fonte da educação no deploy (uso único por fonte + SHA). Vazio = desligada. Ver docs/OPERATIONS.md.
SIGPMF_RELEITURA_FONTE=
# Segundos que a releitura espera o /health da própria app antes de recusar com sem_saude (padrão 600).
SIGPMF_RELEITURA_SAUDE_MAX_S=600
# Porta do /health local que a releitura consulta (http://127.0.0.1:<porta>/health). Padrão 8000; ajuste se o backend mudar de porta.
SIGPMF_RELEITURA_SAUDE_PORTA=8000

# Conector SEI (PRODESP/ROTA), somente leitura. Sem as URLs fica inerte (409). Valores só nas variáveis do servidor,
# nunca no repositório. Sem fallback entre ambientes: oficial por padrão; homologação só com USAR_HOMOLOGACAO=true.
# Só os nomes. Valores oficiais (não secretos) em docs/INTEGRATIONS.md, seção "SEI: valores oficiais".
SIGPMF_SRC_SEI_BASE_PROCESSOS=
SIGPMF_SRC_SEI_BASE_DOCUMENTOS=
SIGPMF_SRC_SEI_BASE_PARAMETROS=
SIGPMF_SRC_SEI_IDP_URL=
SIGPMF_SRC_SEI_IDP_TOKEN_PATH=
SIGPMF_SRC_SEI_USAR_HOMOLOGACAO=false
SIGPMF_SRC_SEI_HML_BASE_PROCESSOS=
SIGPMF_SRC_SEI_HML_BASE_DOCUMENTOS=
SIGPMF_SRC_SEI_HML_BASE_PARAMETROS=
SIGPMF_SRC_SEI_HML_IDP_URL=
SIGPMF_SRC_SEI_HML_IDP_TOKEN_PATH=
SIGPMF_SRC_SEI_IDP_CLIENT_ID=
SIGPMF_SRC_SEI_SIGLA_SISTEMA=
SIGPMF_SRC_SEI_ID_UNIDADE=
SIGPMF_SRC_SEI_REGIONAL=
# SEGREDOS: preencher só na variável/segredo do servidor (Railway/Coolify). Nunca commitar valor.
SIGPMF_SRC_SEI_IDP_CLIENT_SECRET=
SIGPMF_SRC_SEI_IDENTIFICACAO_SERVICO=
# Carga incremental (andamentos) só depois da validação da amostra pelo Leandro, e só na janela noturna.
SIGPMF_SRC_SEI_CARGA_LIBERADA=false
SIGPMF_SRC_SEI_MAX_PAGINAS_POR_EXECUCAO=1

# PR-06: acesso por secretaria nas consultas nominais. Só "true" liga; ligue DEPOIS de a TI cadastrar os vínculos (ver docs/OPERATIONS.md).
SIGPMF_RBAC_SECRETARIA=
